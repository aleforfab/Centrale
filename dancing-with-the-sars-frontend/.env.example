# Server-side proxy target for /api/* and /products/*.
# The backend address never reaches the browser. On the VM this is loopback.
BACKEND_URL=http://127.0.0.1:8000

# Optional override for the committed public Mapbox token in lib/mapboxToken.ts.
# A public `pk.*` token is safe to expose in client-side code; a secret `sk.*`
# token must never be placed here or committed. Keep this blank to use the
# committed demo token. CI deliberately sets `dummy_token`; the app falls back
# to the public demo token instead of losing its basemap.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Leave unset. Setting it makes the browser call that origin directly, which
# breaks the same-origin proxy and exposes the backend address.
# NEXT_PUBLIC_API_URL=
