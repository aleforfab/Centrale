# Optional Earth Engine service-account authentication.
# EE_PRIVATE_KEY is the JSON key content, not a filesystem path.
EE_SERVICE_ACCOUNT=""
EE_PRIVATE_KEY=""
EE_PROJECT=""
EE_SAR_COLLECTION="COPERNICUS/S1_GRD"

# ASF/Earthdata credentials for NISAR data access
# Use ONE of the following authentication methods:
# 1. Token (recommended): EARTHDATA_TOKEN=your_token_here
# 2. Username/password: EARTHDATA_USERNAME and EARTHDATA_PASSWORD
# 3. .netrc file in home directory
EARTHDATA_TOKEN=""
EARTHDATA_USERNAME=""
EARTHDATA_PASSWORD=""

# Feature flags
ENABLE_SENTINEL1_FALLBACK=false

# Runtime live fetch (POST /api/nisar/fetch)
# Enabled by default; set to false to serve only precomputed products.
# Earthdata credentials and the size cap below still guard every live build.
# Catalog searches are cached for this many seconds; stale results are served
# if ASF is temporarily unreachable unless LIVE_FETCH_STALE_ON_ERROR=false.
ENABLE_LIVE_FETCH=true
LIVE_FETCH_TTL_SECONDS=3600
LIVE_FETCH_STALE_ON_ERROR=true
LIVE_FETCH_MAX_GRANULES=6
LIVE_FETCH_MAX_BYTES=2147483648
LIVE_FETCH_MIN_ZOOM=6
LIVE_FETCH_MAX_ZOOM=10
LIVE_FETCH_TILE_BUDGET_MB=60

# Background fetch jobs (POST /api/nisar/fetch returns 202 + a polling URL)
LIVE_FETCH_MAX_WORKERS=2
LIVE_FETCH_JOB_RETENTION_SECONDS=86400

# Paths
# Keep products and caches outside the source tree on a deployment host.
PRODUCTS_DIR=./products
CACHE_DIR=./.cache

# CORS configuration
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
