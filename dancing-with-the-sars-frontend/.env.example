# Server-side proxy target for /api/* and /products/*.
# The backend address never reaches the browser. On the VM this is loopback.
BACKEND_URL=http://127.0.0.1:8000

# URL-restricted public Mapbox token. Never commit a real value.
# Without it the app still shows data, dates and provenance, but no basemap.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Leave unset. Setting it makes the browser call that origin directly, which
# breaks the same-origin proxy and exposes the backend address.
# NEXT_PUBLIC_API_URL=
